DATABASE_URL="postgresql://dataarena:dataarena_dev@localhost:5432/dataarena?schema=public"
# Production (Supabase): use Direct connection URI from Supabase → Settings → Database
# postgresql://postgres.xxx:PASSWORD@db.xxx.supabase.co:5432/postgres?sslmode=require
REDIS_URL="redis://localhost:6379"

PORT=4000
NODE_ENV=development

FRONTEND_URL="http://localhost:3000"

# Brevo transactional email (https://app.brevo.com)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
# Display name shown in the inbox — can differ per project; must use a verified sender in Brevo.
BREVO_SENDER_NAME="DataArena"

JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

COOKIE_SECURE="false"
# In production, secure cookies are enabled automatically when NODE_ENV=production.
# Set COOKIE_SECURE="true" explicitly if needed.

# Optional: max wait for DB check on GET /api/v1/health/ready (milliseconds, 1000–30000)
# HEALTH_CHECK_DB_TIMEOUT_MS="8000"

# Render free tier: while the API is running, ping yourself so idle sleep (~15 min) does not kick in.
# On Render, set KEEPALIVE_ENABLED=true — RENDER_EXTERNAL_URL is injected automatically.
# KEEPALIVE_ENABLED="false"
# KEEPALIVE_INTERVAL_MINUTES="8"
# KEEPALIVE_URL="https://your-api.onrender.com/api/v1/health/ready"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  EDITOR
  ADMIN
}

enum ArticleStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  PUBLISHED
  REJECTED
}

enum TopicStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(USER)
  linkedinUrl   String?
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens RefreshToken[]
  articles      Article[]
  claimedTopics Topic[]        @relation("ClaimedTopics")
  assignedTopics Topic[]       @relation("AssignedTopicAuthors")
  editRequestsMade Article[]   @relation("EditRequestsBy")
  editAssignments  Article[]   @relation("EditAssignments")
  articlesLastEdited Article[] @relation("ArticleLastEditor")
  writingStandardsUpdated WritingStandard[]
  interviewExperiences InterviewExperience[]
  interviewExperienceReports InterviewExperienceReport[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics Topic[]

  @@map("categories")
}

model Topic {
  id             String      @id @default(cuid())
  categoryId     String
  name           String
  slug           String
  description    String?
  sortOrder      Int         @default(0)
  published      Boolean     @default(true)
  openForAuthors    Boolean     @default(false)
  status            TopicStatus @default(OPEN)
  claimedById       String?
  assignedAuthorId  String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  claimedBy      User?    @relation("ClaimedTopics", fields: [claimedById], references: [id], onDelete: SetNull)
  assignedAuthor User?    @relation("AssignedTopicAuthors", fields: [assignedAuthorId], references: [id], onDelete: SetNull)
  articles       Article[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([claimedById])
  @@index([assignedAuthorId])
  @@map("topics")
}

model Article {
  id            String        @id @default(cuid())
  topicId       String
  authorId      String?
  title         String
  slug          String
  content       String        @db.Text
  status        ArticleStatus @default(DRAFT)
  reviewComment String?
  sortOrder     Int           @default(0)
  published     Boolean       @default(false)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  publishedAt           DateTime?
  authorNameSnapshot    String?
  authorLinkedinSnapshot String?
  editRequestedAt       DateTime?
  editRequestNote       String?
  editRequestedById     String?
  editAssigneeId        String?
  lastEditedById        String?
  lastEditedByRole      Role?
  adminEditedAt         DateTime?
  editorEditedAt        DateTime?
  lastEditorNameSnapshot String?
  createdAt             DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  editRequestedBy User? @relation("EditRequestsBy", fields: [editRequestedById], references: [id], onDelete: SetNull)
  editAssignee    User? @relation("EditAssignments", fields: [editAssigneeId], references: [id], onDelete: SetNull)
  lastEditedBy    User? @relation("ArticleLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)

  @@unique([topicId, slug])
  @@index([topicId])
  @@index([authorId])
  @@index([status])
  @@map("articles")
}

enum FeedbackStatus {
  NEW
  READ
  ARCHIVED
}

enum WritingStandardKey {
  MANDATORY
  ESSENTIAL
}

enum InterviewExperienceStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  PUBLISHED
  REJECTED
}

enum InterviewResult {
  SELECTED
  REJECTED
  OFFER_DECLINED
  PENDING
  WITHDRAWN
}

enum ExperienceLevel {
  FRESHER
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum RoleLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  STAFF
}

enum InterviewRoundType {
  ONLINE_TEST
  PHONE_SCREEN
  TECHNICAL
  SYSTEM_DESIGN
  HR
  MANAGERIAL
  OTHER
}

enum InterviewReportReason {
  INCORRECT_INFO
  SPAM
  OFFENSIVE
  DUPLICATE
}

model WritingStandard {
  id          String             @id @default(cuid())
  key         WritingStandardKey @unique
  title       String
  content     String             @db.Text
  updatedById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("writing_standards")
}

model ContactMessage {
  id        String         @id @default(cuid())
  name      String
  email     String
  message   String         @db.Text
  status    FeedbackStatus @default(NEW)
  userId    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

model BugReport {
  id        String         @id @default(cuid())
  name      String
  email     String
  area      String
  pageUrl   String?
  message   String         @db.Text
  status    FeedbackStatus @default(NEW)
  userId    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("bug_reports")
}

model InterviewExperience {
  id                     String                    @id @default(cuid())
  authorId               String
  slug                   String                    @unique
  title                  String
  company                String
  role                   String
  experienceLevel        ExperienceLevel
  yearsOfExperience      String                    @default("1+")
  roleLevel              RoleLevel                 @default(MID)
  interviewYear          Int
  location               String?
  result                 InterviewResult
  overview               String                    @db.Text
  preparationTips        String                    @db.Text
  finalAdvice            String                    @db.Text
  status                 InterviewExperienceStatus @default(DRAFT)
  reviewComment          String?
  submittedAt            DateTime?
  reviewedAt             DateTime?
  publishedAt            DateTime?
  authorNameSnapshot     String?
  authorLinkedinSnapshot String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  author  User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rounds  InterviewRound[]
  reports InterviewExperienceReport[]

  @@index([authorId])
  @@index([status])
  @@index([company])
  @@index([role])
  @@index([experienceLevel])
  @@index([publishedAt])
  @@map("interview_experiences")
}

model InterviewRound {
  id                  String             @id @default(cuid())
  experienceId        String
  sortOrder           Int                @default(0)
  name                String
  roundType           InterviewRoundType
  duration            String?
  difficulty          String?
  questionsAsked      String             @db.Text
  candidateExperience String             @db.Text
  outcome             String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  experience InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@map("interview_rounds")
}

model InterviewExperienceReport {
  id           String                @id @default(cuid())
  experienceId String
  reporterId   String?
  reason       InterviewReportReason
  details      String?               @db.Text
  status       FeedbackStatus        @default(NEW)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  experience InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  reporter   User?               @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([experienceId])
  @@index([status])
  @@index([createdAt])
  @@map("interview_experience_reports")
}
